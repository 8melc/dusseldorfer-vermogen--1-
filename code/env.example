# ============================================
# ENVIRONMENT VARIABLES - FRONTEND
# ============================================
# Erstelle eine Datei: frontend/.env.local
# Kopiere die Werte die du brauchst dorthin

# App Configuration
VITE_APP_ID=koelner-vermoegen
VITE_APP_TITLE="Kölner Vermögen"
VITE_APP_BASE_PATH=/

# API Configuration
# WICHTIG: Ändere diese URLs zu deiner Backend-URL wenn deployed
VITE_API_URL=http://localhost:8000
VITE_WS_API_URL=ws://localhost:8000
VITE_API_HOST=
VITE_API_PATH=
VITE_API_PREFIX_PATH=

# ============================================
# ENVIRONMENT VARIABLES - BACKEND
# ============================================
# Erstelle eine Datei: backend/.env
# Kopiere die Werte die du brauchst dorthin

# Environment Mode (optional)
# DATABUTTON_SERVICE_TYPE=prodx  # Setze auf "prodx" für Production

# Firebase Authentication (WICHTIG wenn du Firebase Auth verwendest!)
# Gehe zu Firebase Console → Project Settings → Copy firebaseConfig
# Dann setze diese Variable (als EINE Zeile, kein Linebreak!):
# DATABUTTON_EXTENSIONS='[{"name":"firebase-auth","version":"1.0.0","config":{"firebaseConfig":{"apiKey":"DEIN_API_KEY","authDomain":"dein-projekt.firebaseapp.com","projectId":"dein-projekt-id","storageBucket":"dein-projekt.appspot.com","messagingSenderId":"123456789","appId":"1:123456789:web:abc123"},"signInOptions":{"google":true,"emailAndPassword":true,"github":false,"facebook":false,"twitter":false,"magicLink":false},"siteName":"Kölner Vermögen","signInSuccessUrl":"/"}}}]'

# Optional: Stripe Keys (wenn Stripe verwendet wird)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Other API Keys
# OPENAI_API_KEY=...
# ELEVENLABS_API_KEY=...
